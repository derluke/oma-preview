# Maintainer: Lukas Innig (derluke on GitHub)
pkgname=folio-pdf
pkgver=0.7.0
pkgrel=1
pkgdesc='A small Omarchy-native PDF reader and editor with visible agent review'
arch=('x86_64' 'aarch64')
url='https://github.com/derluke/pdf'
license=('MIT')
depends=('quickshell' 'qt6-declarative' 'qt6-webengine' 'qpdf' 'poppler' 'librsvg' 'gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "pdf-$pkgver"
    cargo fetch --locked
}

build() {
    cd "pdf-$pkgver"
    cargo build --frozen --release
}

check() {
    cd "pdf-$pkgver"
    cargo test --frozen
}

package() {
    cd "pdf-$pkgver"
    install -Dm755 target/release/folio "$pkgdir/usr/bin/folio"
    install -d "$pkgdir/usr/share/folio/ui"
    install -m644 ui/*.qml ui/qmldir "$pkgdir/usr/share/folio/ui/"
    install -Dm644 data/org.omarchy.folio.desktop "$pkgdir/usr/share/applications/org.omarchy.folio.desktop"
    install -Dm644 assets/org.omarchy.folio.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.omarchy.folio.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 skills/folio-pdf/SKILL.md "$pkgdir/usr/share/folio/skills/folio-pdf/SKILL.md"
    install -Dm644 skills/folio-pdf/agents/openai.yaml "$pkgdir/usr/share/folio/skills/folio-pdf/agents/openai.yaml"
}
