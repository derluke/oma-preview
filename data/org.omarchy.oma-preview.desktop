[Desktop Entry]
Type=Application
Name=Oma Preview
GenericName=PDF Viewer
Comment=Read, fill, sign, and rearrange PDFs
Exec=oma-preview --gui %F
Icon=org.omarchy.oma-preview
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
Keywords=pdf;preview;sign;fill;merge;split;
StartupWMClass=org.omarchy.oma-preview
